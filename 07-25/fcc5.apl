idxs ← (I + (-grid[i;j]+1) + ⍳ grid[i;j] + 1 + grid[i;j]) ∘., J + (-grid[i;j]+1) + ⍳ grid[i;j] + 1 + grid[i;j]

1@idxs ⊢(⍴p)⍴0

