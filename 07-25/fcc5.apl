(⍸ 1 ⌊ p) {0@(⊂⍺) ⊢ 1@((⍺[1] + (-grid[⍵[1];⍵[2]]+1) + ⍳ grid[⍵[1];⍵[2]] + 1 + grid[⍵[1];⍵[2]]) ∘., ⍺[2] + (-grid[⍵[1];⍵[2]]+1) + ⍳ grid[⍵[1];⍵[2]] + 1 + grid[⍵[1];⍵[2]])⊢(⍴p)⍴0} ¨ ⍸ 1 ⌊ grid

∧/ (⍸ 1 ⌊ p) {0@(⊂⍺) ⊢ 1@((⍺[1] + (-grid[⍵[1];⍵[2]]+1) + ⍳ grid[⍵[1];⍵[2]] + 1 + grid[⍵[1];⍵[2]]) ∘., ⍺[2] + (-grid[⍵[1];⍵[2]]+1) + ⍳ grid[⍵[1];⍵[2]] + 1 + grid[⍵[1];⍵[2]])⊢(⍴p)⍴0} ¨ ⍸ 1 ⌊ grid

